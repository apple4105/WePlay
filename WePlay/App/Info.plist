<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>WePlay</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>16.0</string>

	<!-- M3 起要用 BLE（虚拟 accessory 广播 + ICCOA 握手） -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>WePlay 需要蓝牙来与车机建立 CarPlay 投屏连接。</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>WePlay 需要蓝牙广播配件身份，让 iPhone 认载为车机。</string>
	<!-- BLE 扫描在部分系统版本上还要求定位授权 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WePlay 需要定位权限以扫描附近车机的蓝牙广播。</string>
	<!-- M4 起音视频走本地网络 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>WePlay 需要本地网络把 CarPlay 画面传给车机。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>WePlay 需要麦克风以支持 CarPlay 语音输入。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- M7 二期音频同传时需要后台播放 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
